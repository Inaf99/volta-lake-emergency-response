# Copy this file to backend/.env and fill in your own values.
# Never commit the real .env file.

# --- Server ---
PORT=5000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/volta_lake_emergency

# --- Auth ---
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# --- SMS ---
# SMS_PROVIDER=demo   -> simulates sending, never crashes, always works for class demo
# SMS_PROVIDER=twilio -> sends real SMS using the Twilio credentials below
SMS_PROVIDER=demo
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Maps ---
# Used only to build "view on map" links sent inside SMS/notifications.
MAP_PROVIDER=https://www.openstreetmap.org/?mlat={lat}&mlon={lng}#map=16/{lat}/{lng}
